{
  "name": "forest-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src tests *.json *.ts *.html src-tauri/*.json src-tauri/capabilities/*.json",
    "format": "prettier --write src tests *.json *.ts *.html src-tauri/*.json src-tauri/capabilities/*.json",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@vue-flow/core": "1.48.2",
    "elkjs": "0.12.1",
    "lucide-vue-next": "1.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
